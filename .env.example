# Application Configuration
PORT=4000
NODE_ENV=development

# SQL Relational Database URL
# For SQLite (default, zero friction): file:./dev.db
# For PostgreSQL: postgresql://username:password@localhost:5432/task_two?schema=public
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production
JWT_EXPIRES_IN=7d

# Security & CORS
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
